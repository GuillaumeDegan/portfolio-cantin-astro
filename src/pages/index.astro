---
export const prerender = false;
import WorkCard from "../components/WorkCard.astro";
import Layout from "../layouts/Layout.astro";
import { sanity } from "../lib/sanity";
import muteIconUrl from "../assets/mute-icon.svg?url";
import unmuteIconUrl from "../assets/unmute-icon.svg?url";
import "../styles/home.css";
import { coverItemGroq, type CoverRaw } from "../lib/cover";

export type WorkListItem = {
  title: string;
  publishedAt: string;
  categories: {
    title: string;
    slug: string;
  }[];
  coverItem: CoverRaw | null;
  slug: {
    current: string;
  };
};

const category = Astro.url.searchParams.get("category");

const categories = await sanity.fetch<{ title: string; slug: string }[]>(`
  *[_type == "category"]{
    title,
    "slug": slug.current
  }
`);

const works = await sanity.fetch<WorkListItem[]>(
  `*[_type == "project" ${category ? `&& $category in categories[]->slug.current` : ""}] | order(publishedAt desc) {
    title,
    publishedAt,
    "categories": categories[]->{
      title,
      "slug": slug.current
    },
    ${coverItemGroq},
    slug{
      current
    }
  }`,
  { category }
);

const homeBackgroundVideo = await sanity.fetch<{ videoUrl: string | null } | null>(
  `*[_id == "homeBackgroundVideo"][0]{ "videoUrl": video.asset->url }`
);
const homeVideoSrc = homeBackgroundVideo?.videoUrl ?? undefined;
---

<Layout>
  <section class="video-hero" aria-hidden="true">
    <div class="video-hero__frame">
      {
        homeVideoSrc ? (
          <>
            <video src={homeVideoSrc} autoplay muted loop playsinline data-hero-video />
            <button
              type="button"
              class="video-hero__mute"
              data-hero-mute
              aria-label="Activer le son de la vidéo"
              aria-pressed="false"
            >
              <img
                class="video-hero__mute-icon"
                data-hero-mute-icon
                src={muteIconUrl}
                alt=""
                width="16"
                height="16"
              />
            </button>
          </>
        ) : null
      }
    </div>
  </section>

  <section id="works">
    <div class="filters">
      <a href="/#works" class={!category ? "active" : ""}>All</a>

      {
        categories.map((cat) => (
          <a href={`/?category=${cat.slug}#works`} class={category === cat.slug ? "active" : ""}>
            {cat.title}
          </a>
        ))
      }
    </div>

    <div style="display: flex; align-items: center; flex-direction: row; flex-wrap: wrap;">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>

  {
    homeVideoSrc ? (
      <script define:vars={{ muteIconUrl, unmuteIconUrl }}>
        const video = document.querySelector("[data-hero-video]");
        const muteBtn = document.querySelector("[data-hero-mute]");
        const muteIcon = document.querySelector("[data-hero-mute-icon]");

        if (video && muteBtn && muteIcon) {
          const updateMuteUi = () => {
            const isMuted = video.muted;
            muteIcon.src = isMuted ? muteIconUrl : unmuteIconUrl;
            muteBtn.setAttribute("aria-label", isMuted ? "Activer le son de la vidéo" : "Couper le son de la vidéo");
            muteBtn.setAttribute("aria-pressed", String(!isMuted));
          };

          updateMuteUi();

          muteBtn.addEventListener("click", () => {
            video.muted = !video.muted;
            updateMuteUi();
          });
        }
      </script>
    ) : null
  }
</Layout>
