---
import type { WorkListItem } from "../pages/index.astro";


const { work } = Astro.props as { work: WorkListItem };
---

<a
	class="work-card"
	href={`/works/${work.slug.current}`}
	data-title={work.title}
>
	<img
		class="work-card__image"
		src={work.coverImage.url}
		alt={work.coverImage.alt}
		loading="lazy"
		decoding="async"
	/>
</a>

<style>
	.work-card {
		position: relative;
		display: block;
		height: 250px;
		width: 33%;
		overflow: hidden;
		text-decoration: none;
		color: #fff;
	}

	.work-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.work-card::after {
		content: attr(data-title);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		box-sizing: border-box;
		background: #000;
		text-align: center;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		opacity: 0;
		transition: opacity 0.2s ease;
		pointer-events: none;
	}

	.work-card:hover::after,
	.work-card:focus-visible::after {
		opacity: 1;
	}

	@media (max-width: 768px) {
		.work-card {
			width: 100%;
		}
	}
</style>
