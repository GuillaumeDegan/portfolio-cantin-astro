---
import { isAfter, isValid, parseISO, subMonths } from "date-fns";
import { resolveCover } from "../lib/cover";
import type { WorkListItem } from "../pages/index.astro";

const { work } = Astro.props as { work: WorkListItem };

function isNewProject(publishedAt: string): boolean {
  const published = parseISO(publishedAt);
  if (!isValid(published)) return false;
  return isAfter(published, subMonths(new Date(), 3));
}

const isNew = isNewProject(work.publishedAt);
const cover = resolveCover(work.coverItem);
---

<a class="work-card" href={`/works/${work.slug.current}`} data-title={work.title}>
  {isNew && <span class="work-card__new">new</span>}
  {
    cover ? (
      <img
        class="work-card__image"
        src={cover.kind === "image" ? cover.src : cover.thumbUrl}
        alt={cover.alt}
        loading="lazy"
        decoding="async"
      />
    ) : null
  }
</a>
